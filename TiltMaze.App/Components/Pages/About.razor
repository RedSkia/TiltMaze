@page "/about"

<div class="page-narrow about-page">
    <section class="hero">
        <img class="app-logo" src="images/logo.svg" alt="" width="88" height="88" />
        <h1>TiltMaze</h1>
        <p class="tagline">Tilt, roll, escape the maze</p>
        <span class="version">Version @version</span>
    </section>

    <section class="card">
        <h2>What is TiltMaze?</h2>
        <p>
            TiltMaze is a maze game. Tilt your phone to roll the ball to the goal, or use the arrow keys or WASD on a computer.
            Watch out for the holes: if you fall in, you start over, but a fast ball can jump over them. Every maze is made from a seed, so you can replay it, and the daily maze is the same for everyone. Beat your best time and race your own ghost.
        </p>
    </section>

    <section class="card maker">
        <span class="section-label">Made by</span>
        <div class="maker-head">
            <img class="maker-logo" src="images/redskia.svg" alt="" width="64" height="64" />
            <div>
                <strong class="maker-name">Marcus</strong>
                <span class="maker-brand">RedSkia.Dev</span>
                <span class="muted">Full Stack Developer · C# and .NET</span>
            </div>
        </div>
        <div class="links">
            <button type="button" class="button brand" @onclick="@(() => Open("https://redskia.dev"))">redskia.dev</button>
            <button type="button" class="button" @onclick="@(() => Open("https://www.linkedin.com/in/marcusdk/"))">LinkedIn</button>
            <button type="button" class="button" @onclick="@(() => Open("https://github.com/RedSkia/TiltMaze"))">Source code on GitHub</button>
        </div>
    </section>

    <p class="footer muted">School project in App Programming 2026 · © RedSkia.Dev</p>
</div>
