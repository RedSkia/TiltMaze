@page "/play/{DifficultyName}/{Seed:int?}"
@implements IDisposable

@if (maze != null)
{
    <div class="game">
        <div class="hud">
            <div class="stat mode-stat">
                <span class="stat-label">@(isDaily ? "Daily" : "Random")</span>
                <span class="stat-value">@maze.Difficulty</span>
            </div>
            <div class="stat">
                <span class="stat-label">Time</span>
                <span class="stat-value">@Format.Time(time)</span>
            </div>
            <div class="stat">
                <span class="stat-label">Best</span>
                <span class="stat-value">@(best == null ? "-" : Format.Time(best.Value))</span>
            </div>
            <div class="stat">
                <span class="stat-label">Falls</span>
                <span class="stat-value">@falls</span>
            </div>
            <div class="hud-buttons">
                <button type="button" class="button" @onclick="TogglePause">@(paused ? "Resume" : "Pause")</button>
                <a class="button" href="">Menu</a>
            </div>
            <p class="seed muted">Seed @maze.Seed</p>
            <p class="hint muted">@hint</p>
        </div>

        <div class="board-area">
            <!-- Fokuseret felt: tastaturet virker kun, når det har fokus. Piletaster og mellemrum blokeres kun mens man spiller. -->
            <div class="board" tabindex="0" @ref="board" @onkeydown="KeyDown" @onkeyup="KeyUp" @onfocusout="ClearKeys"
                 @onkeydown:preventDefault="playing" @onkeyup:preventDefault="playing">
                <svg viewBox="-0.15 -0.15 @N(maze.Width + 0.3) @N(maze.Height + 0.3)" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Maze">
                    <defs>
                        <linearGradient id="floorFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#1d1a30" />
                            <stop offset="1" stop-color="#141226" />
                        </linearGradient>
                        <pattern id="tiles" width="1" height="1" patternUnits="userSpaceOnUse">
                            <rect width="1" height="1" fill="none" stroke="#ffffff" stroke-opacity="0.05" stroke-width="0.02" />
                        </pattern>
                        <linearGradient id="wallTop" x1="0" y1="0" x2="@maze.Width" y2="@maze.Height" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#a78bfa" />
                            <stop offset="1" stop-color="#f472b6" />
                        </linearGradient>
                        <radialGradient id="holeFill" cx="50%" cy="50%" r="50%">
                            <stop offset="0" stop-color="#000" />
                            <stop offset="0.7" stop-color="#05040a" />
                            <stop offset="1" stop-color="#2e2650" />
                        </radialGradient>
                        <radialGradient id="ballFill" cx="35%" cy="35%" r="70%">
                            <stop offset="0" stop-color="#f4f2fa" />
                            <stop offset="1" stop-color="#b49cff" />
                        </radialGradient>
                        <path id="wallShape" d="@wallPath" fill="none" />
                    </defs>
                    <rect class="floor" x="0" y="0" width="@maze.Width" height="@maze.Height" rx="0.1" />
                    <rect class="tiles" x="0" y="0" width="@maze.Width" height="@maze.Height" />
                    <rect class="start" x="@maze.Start.X" y="@maze.Start.Y" width="1" height="1" />
                    @foreach (var hole in maze.Holes)
                    {
                        <circle class="hole" cx="@N(hole.CenterX)" cy="@N(hole.CenterY)" r="@N(hole.Radius)" />
                        <circle class="hole-rim" cx="@N(hole.CenterX + 0.01)" cy="@N(hole.CenterY + 0.015)" r="@N(hole.Radius * 0.75)" />
                    }
                    <circle class="goal" cx="@N(maze.Goal.X + 0.5)" cy="@N(maze.Goal.Y + 0.5)" r="0.3" />
                    <circle class="goal-core" cx="@N(maze.Goal.X + 0.5)" cy="@N(maze.Goal.Y + 0.5)" r="0.15" />
                    <use href="#wallShape" class="wall-shadow" transform="translate(0.1 0.14)" />
                    <use href="#wallShape" class="wall-side" transform="translate(0.04 0.06)" />
                    <use href="#wallShape" class="wall-top" />
                    @if (showGhost)
                    {
                        <circle class="ghost" cx="@N(ghostX)" cy="@N(ghostY)" r="@N(Ball.Radius)" />
                    }
                    <circle class="ball-shadow" cx="@N(ball.X + 0.05)" cy="@N(ball.Y + 0.07)" r="@N(Ball.Radius)" />
                    <circle class="ball" cx="@N(ball.X)" cy="@N(ball.Y)" r="@N(Ball.Radius)" />
                    <circle class="ball-shine" cx="@N(ball.X - 0.08)" cy="@N(ball.Y - 0.09)" r="0.07" />
                </svg>
            </div>

            @if (paused && !finished)
            {
                <div class="overlay">
                    <div class="card dialog">
                        <h2>Paused</h2>
                        <button type="button" class="button primary" @onclick="TogglePause">Resume</button>
                        <button type="button" class="button" @onclick="Retry">Retry</button>
                        <button type="button" class="button" @onclick="NewMaze">New maze</button>
                        <a class="button" href="">Menu</a>
                    </div>
                </div>
            }
            @if (finished)
            {
                <div class="overlay">
                    <div class="card dialog">
                        <h2>Maze complete</h2>
                        <p class="result-time">@Format.Time(time)</p>
                        @if (newBest)
                        {
                            <p class="record">New best time!</p>
                        }
                        <div class="dialog-buttons">
                            <button type="button" class="button primary" @onclick="NewMaze">New maze</button>
                            <button type="button" class="button" @onclick="Retry">Retry</button>
                            <a class="button" href="">Menu</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
