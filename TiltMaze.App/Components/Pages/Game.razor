@page "/play/{DifficultyName}/{Seed:int?}"
@implements IDisposable

@if (maze != null)
{
    <div class="game">
        <!-- HUD: tid (stor), forskel til spøgelset, pause og menu. På landskab/computer et sidepanel -->
        <header class="hud" inert="@modalOpen">
            <button type="button" class="icon-button hud-pause" aria-label="Pause" @onclick="TogglePause">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg>
            </button>
            <div class="clock">
                <span class="clock-time"><span class="sr-only">Time </span>@Format.Time(time)</span>
                @if (delta != null)
                {
                    <span class="delta @(delta < 0 ? "ahead" : "behind")">@Format.Delta(delta.Value) <small>ghost</small></span>
                }
            </div>

            <dl class="stats">
                <div class="mode">
                    <dt class="sr-only">Maze</dt>
                    <dd>@(isDaily ? "Daily" : "Random") · @maze.Difficulty</dd>
                </div>
                <div>
                    <dt>Best</dt>
                    <dd>@(best == null ? "-" : Format.Time(best.Value))</dd>
                </div>
                <div>
                    <dt>Falls</dt>
                    <dd>@falls</dd>
                </div>
                <div class="coins-chip">
                    <dt>Coins</dt>
                    <dd>@runCoins</dd>
                </div>
                <div class="seed">
                    <dt>Seed</dt>
                    <dd>@maze.Seed</dd>
                </div>
            </dl>
            <p class="hint muted">@hint</p>
            <div class="side-buttons">
                <button type="button" class="button" @onclick="TogglePause">Pause</button>
                <button type="button" class="button" @onclick="Retry">Retry</button>
            </div>
        </header>

        <div class="board-area">
            <!-- Fokuseret felt: tastaturet virker kun, når det har fokus. Piletaster og mellemrum blokeres kun mens man spiller -->
            <div class="board @ShakeClass" tabindex="0" @ref="board" inert="@modalOpen"
                 @onkeydown="KeyDown" @onkeyup="KeyUp" @onfocusout="ClearKeys"
                 @onkeydown:preventDefault="playing" @onkeyup:preventDefault="playing">
                <svg viewBox="@ViewBox" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Maze">
                    <defs>
                        <!-- Kuglens farver kommer fra den valgte farve i butikken -->
                        <radialGradient id="ballFill" cx="35%" cy="30%" r="75%">
                            <stop offset="0" stop-color="#fff4e6" />
                            <stop offset="0.35" stop-color="@ballColor.Light" />
                            <stop offset="0.75" stop-color="@ballColor.Mid" />
                            <stop offset="1" stop-color="@ballColor.Dark" />
                        </radialGradient>
                        <radialGradient id="ballGlow">
                            <stop offset="0" stop-color="@ballColor.Mid" stop-opacity="0.45" />
                            <stop offset="1" stop-color="@ballColor.Mid" stop-opacity="0" />
                        </radialGradient>
                    </defs>

                    <!-- Den faste bane tegnes kun, når labyrinten skifter -->
                    <MazeLayer Maze="maze" />

                    <!-- Mønter: guld. Dem fra tidligere løb er svage (de giver ikke flere mønter), dem taget nu forsvinder -->
                    @for (int i = 0; i < picked.Length; i++)
                    {
                        @if (!picked[i])
                        {
                            <g class="coin @(IsOldCoin(i) ? "old" : "")">
                                <circle cx="@N(maze.Coins[i].X + 0.5)" cy="@N(maze.Coins[i].Y + 0.5)" r="@N(Course.CoinRadius)" />
                                <circle class="coin-shine" cx="@N(maze.Coins[i].X + 0.5 - 0.03)" cy="@N(maze.Coins[i].Y + 0.5 - 0.03)" r="0.04" />
                            </g>
                        }
                    }
                    @if (pops > 0)
                    {
                        <!-- Ny @key ved hver mønt, så ringen starter sin animation forfra -->
                        <circle @key="pops" class="coin-pop" cx="@N(popX)" cy="@N(popY)" r="0.2" />
                    }

                    @if (falls > 0)
                    {
                        <!-- Ny @key ved hvert fald, så ringen starter sin animation forfra -->
                        <circle @key="falls" class="spawn" cx="@N(maze.Start.X + 0.5)" cy="@N(maze.Start.Y + 0.5)" r="0.4" />
                    }
                    @if (showGhost)
                    {
                        <circle class="ghost" cx="@N(ghostX)" cy="@N(ghostY)" r="@N(Ball.Radius)" />
                    }
                    @foreach (var rival in rivals)
                    {
                        @if (rival.Show)
                        {
                            <RivalGhost Name="@rival.Name" Color="@rival.Color" X="@rival.X" Y="@rival.Y" />
                        }
                    }
                    <circle class="ball-glow" cx="@N(ball.X)" cy="@N(ball.Y)" r="@N(Ball.Radius * 2)" />
                    <ellipse class="ball-shadow" cx="@N(ball.X + 0.06)" cy="@N(ball.Y + 0.09)" rx="@N(Ball.Radius)" ry="@N(Ball.Radius * 0.85)" />
                    <circle class="ball" cx="@N(ball.X)" cy="@N(ball.Y)" r="@N(Ball.Radius)" />
                    <circle class="ball-shine" cx="@N(ball.X - 0.09)" cy="@N(ball.Y - 0.1)" r="0.06" />
                </svg>
            </div>

            @if (falls > 0)
            {
                <div @key="falls" class="fall-flash"></div>
            }

            @if (follow)
            {
                <!-- Minikort: hele banen i lille, med kuglen og det udsnit, kameraet viser -->
                <svg class="minimap" viewBox="-0.3 -0.3 @N(maze.Width + 0.6) @N(maze.Height + 0.6)" aria-hidden="true">
                    <MazeLayer Maze="maze" Mini="true" />
                    <rect class="mini-view" x="@N(camera.Left)" y="@N(camera.Top)" width="@N(camera.ViewWidth)" height="@N(camera.ViewHeight)" rx="0.3" />
                    @if (showGhost)
                    {
                        <circle class="mini-ghost" cx="@N(ghostX)" cy="@N(ghostY)" r="0.35" />
                    }
                    <circle class="mini-ball" style="fill: @ballColor.Mid" cx="@N(ball.X)" cy="@N(ball.Y)" r="0.45" />
                </svg>
            }

            <!-- Flydende joystick over hele banen: ringen kommer frem, hvor man trykker -->
            <Joystick @ref="joystick" Disabled="@modalOpen" />

            @if (CountText != null)
            {
                <div class="countdown">
                    <!-- Ny @key for hvert tal, så det "popper" frem igen -->
                    <span @key="CountText" class="count @(CountText == "Go!" ? "go" : "")">@CountText</span>
                </div>
            }

            @if (paused && !finished)
            {
                <!-- Pausemenuen er den eneste menu. Leave er selv bekræftelsen, og Esc er det samme som Resume -->
                <div class="overlay" @onkeydown="OverlayKey">
                    <div class="card dialog pause" role="dialog" aria-modal="true" aria-labelledby="dialog-title">
                        <h2 id="dialog-title">Paused</h2>
                        <p class="muted">@maze.Difficulty · Seed @maze.Seed</p>
                        <div class="dialog-buttons">
                            <button type="button" class="button primary big" @ref="dialogButton" @onclick="TogglePause">
                                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
                                <span>Resume</span>
                            </button>
                            <button type="button" class="button" @onclick="Retry">
                                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7" /><path d="M20 4v5h-5" /></svg>
                                <span>Retry</span>
                            </button>
                            <button type="button" class="button leave" @onclick="Leave">
                                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5M15 8l4 4-4 4M19 12H9" /></svg>
                                <span>Leave</span>
                            </button>
                        </div>
                        <p class="pause-note muted">Leaving ends this run. The time is lost.</p>
                    </div>
                </div>
            }
            else if (finished)
            {
                <div class="confetti" aria-hidden="true">
                    @foreach (var piece in confetti)
                    {
                        <i style="@piece"></i>
                    }
                </div>
                <div class="overlay">
                    <div class="card dialog finish" role="dialog" aria-modal="true" aria-labelledby="dialog-title">
                        <h2 id="dialog-title">Maze complete!</h2>
                        <p class="result-time">@Format.Time(time)</p>
                        @if (newBest)
                        {
                            <p><span class="badge gold record">New best time!</span></p>
                        }
                        <p class="muted">
                            @if (oldBest != null)
                            {
                                <span>@Format.Delta(time - oldBest.Value) s vs your best · </span>
                            }
                            <span>@falls @(falls == 1 ? "fall" : "falls")</span>
                        </p>
                        <p class="coins-earned">
                            <span class="coin-dot" aria-hidden="true"></span>
                            <span>+@(runCoins + completionReward) coins</span>
                        </p>
                        <p class="muted">@runCoins from pickups · @completionReward for finishing</p>
                        <div class="dialog-buttons">
                            <button type="button" class="button primary big" @ref="dialogButton" @onclick="NewMaze">New maze</button>
                            <button type="button" class="button" @onclick="Retry">Retry</button>
                            <button type="button" class="button" @onclick="Leave">Menu</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
