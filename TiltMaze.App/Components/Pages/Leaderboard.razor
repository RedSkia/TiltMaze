@page "/leaderboard"

<div class="page-narrow">
    <div class="page-head">
        <div>
            <h1>Leaderboard</h1>
            <p class="page-sub">The fastest times on a maze. Pick a difficulty and the daily maze or a seed.</p>
        </div>
        <button type="button" class="button" @onclick="Load" disabled="@busy">Refresh</button>
    </div>

    <div class="choices" role="group" aria-label="Difficulty">
        @foreach (var d in difficulties)
        {
            <button type="button" class="button @(d == difficulty ? "primary" : "")" aria-pressed="@(d == difficulty)" @onclick="() => SetDifficulty(d)">@d</button>
        }
    </div>

    <div class="segmented" role="group" aria-label="Maze">
        <button type="button" class="@(daily ? "active" : "")" aria-pressed="@daily" @onclick="() => SetDaily(true)">Daily maze</button>
        <button type="button" class="@(daily ? "" : "active")" aria-pressed="@(!daily)" @onclick="() => SetDaily(false)">Seed</button>
    </div>

    @if (!daily)
    {
        <form class="seed-form" @onsubmit="Load">
            <label class="field">
                <span>Seed</span>
                <input type="text" inputmode="numeric" @bind="seedText" maxlength="9" />
            </label>
            <button type="submit" class="button primary" disabled="@busy">Show</button>
        </form>
    }

    @if (error != "")
    {
        <p class="alert error" role="alert">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 2.5 20h19z" /><path d="M12 10v4" /><path d="M12 17.5v.01" /></svg>
            @error
        </p>
    }

    @if (busy)
    {
        <div class="loading" role="status">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (offline)
    {
        <p class="alert notice" role="status">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 2.5 20h19z" /><path d="M12 10v4" /><path d="M12 17.5v.01" /></svg>
            You are offline, or the server is not reachable. Your times are saved and will be sent later.
        </p>
    }
    else if (rows != null && rows.Count == 0)
    {
        <div class="empty-state">
            <p>No times yet on this maze. Be the first!</p>
        </div>
    }
    else if (rows != null)
    {
        <section class="card rows" aria-label="Top 10">
            <ol class="board">
                @foreach (var row in rows)
                {
                    <li class="@(row.IsMe ? "me" : "")">
                        <span class="rank">@row.Rank</span>
                        <span class="name">@row.Nickname@(row.IsMe ? " (you)" : "")</span>
                        <span class="time">@Format.Time(row.TimeMs / 1000.0)</span>
                    </li>
                }
            </ol>
        </section>
    }

    @if (!auth.IsLoggedIn)
    {
        <p class="muted">
            <a href="login">Sign in</a> to put your own times on the leaderboard.
        </p>
    }
</div>
