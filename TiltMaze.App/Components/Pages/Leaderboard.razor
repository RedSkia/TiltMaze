@page "/leaderboard"

<div class="page-narrow">
    <div class="page-head">
        <div>
            <h1>Leaderboard</h1>
            <p class="page-sub">The fastest times on a maze. Pick a difficulty and the daily maze or a seed.</p>
        </div>
        <button type="button" class="icon-button" aria-label="Refresh" @onclick="Load" disabled="@busy">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7" /><path d="M20 4v5h-5" /></svg>
        </button>
    </div>

    <div class="segmented difficulty" role="group" aria-label="Difficulty">
        @foreach (var d in difficulties)
        {
            <button type="button" class="@(d == difficulty ? "active" : "")" aria-pressed="@(d == difficulty)" @onclick="() => SetDifficulty(d)">@d</button>
        }
    </div>

    <div class="segmented" role="group" aria-label="Maze">
        <button type="button" class="@(daily ? "active" : "")" aria-pressed="@daily" @onclick="() => SetDaily(true)">Daily maze</button>
        <button type="button" class="@(daily ? "" : "active")" aria-pressed="@(!daily)" @onclick="() => SetDaily(false)">Seed</button>
    </div>

    @if (!daily)
    {
        <form class="seed-form" @onsubmit="Load">
            <label class="field">
                <span>Seed</span>
                <input type="text" inputmode="numeric" @bind="seedText" maxlength="9" />
            </label>
            <button type="submit" class="button primary" disabled="@busy">Show</button>
        </form>
    }

    @if (error != "")
    {
        <p class="alert error" role="alert">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 2.5 20h19z" /><path d="M12 10v4" /><path d="M12 17.5v.01" /></svg>
            @error
        </p>
    }

    @if (busy)
    {
        <div class="loading" role="status">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (offline)
    {
        <div class="empty-state" role="status">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 2.5 20h19z" /><path d="M12 10v4" /><path d="M12 17.5v.01" /></svg>
            <h2>You are offline</h2>
            <p>The server is not reachable. Your times are saved and will be sent later.</p>
            <button type="button" class="button" @onclick="Load">Try again</button>
        </div>
    }
    else if (rows != null && rows.Count == 0)
    {
        <div class="empty-state">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z" />
                <path d="M7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3" />
            </svg>
            <h2>No times yet</h2>
            <p>Nobody has finished this maze yet. Be the first!</p>
            <a class="button primary" href="@PlayLink">Play this maze</a>
        </div>
    }
    else if (rows != null)
    {
        <section class="card rows" aria-label="Top 10">
            <ol class="board">
                @foreach (var row in rows)
                {
                    <li class="@(row.IsMe ? "me" : "")">
                        <span class="rank">@row.Rank</span>
                        <span class="name">@row.Username@(row.IsMe ? " (you)" : "")</span>
                        <span class="time">@Format.Time(row.TimeMs / 1000.0)</span>
                    </li>
                }
            </ol>
        </section>
    }

    @if (!auth.IsLoggedIn)
    {
        <section class="card cta">
            <p>Sign in to put your own times on the leaderboard.</p>
            <a class="button primary" href="login">Sign in</a>
        </section>
    }
</div>
