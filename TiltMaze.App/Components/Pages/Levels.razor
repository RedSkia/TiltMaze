@page "/"

<div class="page-wide">
    <div class="page-head">
        <div>
            <h1>Levels</h1>
            <p class="page-sub">Roll the ball to the goal. Avoid the holes.</p>
        </div>
    </div>

    <div class="level-grid">
        @for (int level = 1; level <= Scores.LevelCount; level++)
        {
            var best = scores.Best(level);
            <a class="card level @(best != null ? "done" : "")" href="play/@level">
                <span class="level-number">@level</span>
                @if (best != null)
                {
                    <span class="level-best">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
                        @Scores.FormatTime(best.Value)
                    </span>
                }
                else
                {
                    <span class="level-best muted">Not played</span>
                }
            </a>
        }
    </div>
</div>
