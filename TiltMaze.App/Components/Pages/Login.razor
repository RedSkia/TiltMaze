@page "/login"

<div class="page-narrow login">
    <div class="page-head">
        <div>
            <h1>@(creating ? "Create account" : "Sign in")</h1>
            <p class="page-sub">@(creating ? "Put your times on the leaderboard and race other players." : "Welcome back. Your times are waiting.")</p>
        </div>
    </div>

    <div class="segmented" role="group" aria-label="Sign in or create account">
        <button type="button" class="@(creating ? "" : "active")" aria-pressed="@(!creating)" @onclick="() => SetMode(false)" disabled="@busy">Sign in</button>
        <button type="button" class="@(creating ? "active" : "")" aria-pressed="@creating" @onclick="() => SetMode(true)" disabled="@busy">Create account</button>
    </div>

    <form class="login-form" @onsubmit="Submit">
        <label class="field">
            <span>Username</span>
            <input type="text" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="16" disabled="@busy"
                   aria-invalid="@(availability == "taken" || availability == "invalid" ? "true" : null)"
                   aria-describedby="@(creating ? "username-hint availability" : null)"
                   @bind="username" @bind:event="oninput" @bind:after="UsernameChanged" />
            @if (creating)
            {
                <span class="hint muted" id="username-hint">3-16 letters, digits or underscores. Shown on the leaderboard.</span>
                @if (availability != "")
                {
                    <span class="availability @availability" id="availability" role="status">@AvailabilityText</span>
                }
            }
        </label>
        <label class="field">
            <span>Password</span>
            <span class="password-row">
                <input type="@(showPassword ? "text" : "password")" autocomplete="@(creating ? "new-password" : "current-password")" @bind="password" maxlength="100" disabled="@busy"
                       aria-invalid="@(error != "" ? "true" : null)" aria-describedby="@(creating ? "password-hint" : null)" />
                <button type="button" class="button" aria-label="@(showPassword ? "Hide password" : "Show password")" aria-pressed="@showPassword"
                        @onclick="() => showPassword = !showPassword">@(showPassword ? "Hide" : "Show")</button>
            </span>
            @if (creating)
            {
                <span class="hint muted" id="password-hint">At least 8 characters</span>
            }
        </label>
        <button type="submit" class="button primary" disabled="@(busy || (creating && availability == "taken"))">@(creating ? "Create account" : "Sign in")</button>
    </form>

    @if (GoogleAvailable)
    {
        <p class="or muted">or</p>
        <button type="button" class="button google" @onclick="LoginWithGoogle" disabled="@busy">Continue with Google</button>
    }

    @if (busy)
    {
        <div class="loading" role="status">
            <div class="spinner"></div>
            <p>@(creating ? "Creating account..." : "Signing in...")</p>
        </div>
    }

    @if (error != "")
    {
        <p class="alert error" role="alert">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 2.5 20h19z" /><path d="M12 10v4" /><path d="M12 17.5v.01" /></svg>
            @error
        </p>
    }
</div>
