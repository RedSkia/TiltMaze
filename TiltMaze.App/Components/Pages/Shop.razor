@page "/shop"

<div class="page-narrow">
    <div class="page-head">
        <div>
            <h1>Shop</h1>
            <p class="page-sub">Spend your coins on a new ball colour.</p>
        </div>
        <p class="balance" aria-live="polite">
            <span class="coin-dot" aria-hidden="true"></span>
            <span><span class="sr-only">Balance </span>@coins</span>
        </p>
    </div>

    <ul class="colors">
        @foreach (var color in Rewards.BallColors)
        {
            bool owned = wallet.Owns(color);
            bool equipped = color.Id == equippedId;
            <li class="card color @(equipped ? "equipped" : "")">
                <svg class="preview" viewBox="-1 -1 2 2" aria-hidden="true">
                    <defs>
                        <radialGradient id="shop-@color.Id" cx="35%" cy="30%" r="75%">
                            <stop offset="0" stop-color="#fff4e6" />
                            <stop offset="0.35" stop-color="@color.Light" />
                            <stop offset="0.75" stop-color="@color.Mid" />
                            <stop offset="1" stop-color="@color.Dark" />
                        </radialGradient>
                    </defs>
                    <circle cx="0.06" cy="0.1" r="0.8" fill="#000" fill-opacity="0.4" />
                    <circle cx="0" cy="0" r="0.8" fill="url(#shop-@color.Id)" />
                    <circle cx="-0.28" cy="-0.3" r="0.18" fill="#fff" fill-opacity="0.85" />
                </svg>
                <h2>@color.Name</h2>
                <p class="price">
                    @if (equipped)
                    {
                        <span class="badge gold">Equipped</span>
                    }
                    else if (owned)
                    {
                        <span class="badge">Owned</span>
                    }
                    else
                    {
                        <span class="coin-dot" aria-hidden="true"></span>
                        <span>@color.Price</span>
                    }
                </p>
                @if (equipped)
                {
                    <button type="button" class="button" disabled>Equipped</button>
                }
                else if (owned)
                {
                    <button type="button" class="button primary" @onclick="() => Equip(color)">Equip</button>
                }
                else if (coins < color.Price)
                {
                    <button type="button" class="button" disabled>Not enough coins</button>
                }
                else
                {
                    <button type="button" class="button primary" @onclick="() => Buy(color)">Buy</button>
                }
            </li>
        }
    </ul>
</div>
