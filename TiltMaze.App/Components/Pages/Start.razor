@page "/"

<div class="page-wide start">
    <!-- Hovedhandlingen: dagens labyrint i den valgte sværhedsgrad -->
    <section class="card hero" aria-labelledby="hero-title">
        <div class="hero-main">
            <img class="hero-art" src="images/logo.svg" alt="" width="96" height="96" />
            <div class="hero-text">
                <span class="kicker">Daily maze · @today</span>
                <h1 id="hero-title">Today's maze</h1>
                <p class="page-sub">The same maze for everyone. Roll fast to jump over holes.</p>
                <span class="badge">New maze in @timeLeft</span>
            </div>
        </div>
        <div class="hero-play">
            <div class="hero-times">
                <div>
                    <span class="label">Your best today</span>
                    <span class="time">@TimeText(scores.Best(selected, dailySeed))</span>
                </div>
                <div>
                    <span class="label">Best on @selected</span>
                    <span class="time">@TimeText(scores.BestOf(selected))</span>
                </div>
            </div>
            <button type="button" class="button primary big" @onclick="PlayDaily">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
                <span>Play daily</span>
                <span class="level-tag">@selected</span>
            </button>
            <button type="button" class="button" @onclick="PlayRandom">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" />
                </svg>
                <span>Random maze</span>
            </button>
        </div>
    </section>

    <!-- Valg af sværhedsgrad: et kort pr. sværhedsgrad med størrelse, huller og bedste tider -->
    <section aria-labelledby="levels-title">
        <h2 id="levels-title" class="section-label">Difficulty</h2>
        <div class="levels">
            @foreach (var difficulty in difficulties)
            {
                var settings = DifficultySettings.For(difficulty);
                int level = (int)difficulty + 1;
                bool isSelected = difficulty == selected;
                <button type="button" class="level @difficulty.ToString().ToLower() @(isSelected ? "selected" : "")" aria-pressed="@(isSelected ? "true" : "false")"
                        @onclick="() => Select(difficulty)">
                    <span class="level-head">
                        <span class="level-name">@difficulty</span>
                        @if (isSelected)
                        {
                            <svg class="icon check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                        }
                        <span class="pips" aria-hidden="true">
                            @for (int i = 1; i <= 4; i++)
                            {
                                <i class="@(i <= level ? "on" : "")"></i>
                            }
                        </span>
                    </span>
                    <span class="level-info">@settings.Width x @settings.Height · @(settings.SmallHoles + settings.BigHoles) holes</span>
                    <span class="level-times">
                        <span><span class="label">Best</span> <span class="time">@TimeText(scores.BestOf(difficulty))</span></span>
                        <span><span class="label">Today</span> <span class="time">@TimeText(scores.Best(difficulty, dailySeed))</span></span>
                    </span>
                </button>
            }
        </div>
    </section>

    <a class="byline" href="about">
        <img src="images/redskia.svg" alt="" width="20" height="20" />
        <span>by RedSkia.Dev</span>
    </a>
</div>
