@* Flydende joystick: tryk hvor som helst på banen (finger eller mus). Ringen kommer frem dér, hvor man trykkede,
   og knappen følger fingeren. Slip: ringen forsvinder, og styringen er 0 igen.
   Kun til touch og mus (tastaturet styrer ikke kuglen), derfor aria-hidden *@
<div class="stick-zone" @ref="zone" aria-hidden="true" inert="@Disabled"
     @onpointerdown="Down" @onpointerdown:preventDefault="true"
     @onpointermove="Move" @onpointerup="Up" @onpointercancel="Up" @onlostpointercapture="Up"
     @oncontextmenu:preventDefault="true">
    @if (pointerId != null)
    {
        <div class="joystick" style="left: @N(centerX - Size / 2.0)px; top: @N(centerY - Size / 2.0)px; width: @(Size)px; height: @(Size)px">
            <div class="ring-arrows"></div>
            <div class="knob" style="transform: translate(@N(knobX)px, @N(knobY)px)"></div>
        </div>
    }
</div>
