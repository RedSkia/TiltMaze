@* Sporet bag kuglen: små cirkler på de sidste positioner, ældst først (så den nyeste ligger øverst).
   Jo ældre, jo mindre og svagere. Kun udseende og ingen filtre. *@

@{
    var colors = Colors;   // hentes én gang pr. billede
}
@for (int i = 0; i < Points.Count; i++)
{
    var (x, y) = Points.At(i);
    double t = (i + 1.0) / Points.Count;   // 0 = ældst, 1 = nyest
    if (Kind == "sparkle")
    {
        // Gnister: små, med en lille fast forskydning ud fra pladsen (så de ikke flimrer)
        <circle cx="@N(x + Math.Sin(x * 91 + y * 53) * Size * 0.5)" cy="@N(y + Math.Cos(x * 67 + y * 29) * Size * 0.5)"
                r="@N(Size * 0.2 * (0.5 + t))" fill="@colors[i % colors.Length]" fill-opacity="@N(0.9 * t)" />
    }
    else
    {
        // Farverne går fra nyeste (første) til ældste (sidste) punkt
        string color = colors[(int)((1 - t) * colors.Length)];
        <circle cx="@N(x)" cy="@N(y)" r="@N(Size * (0.3 + 0.6 * t))" fill="@color" fill-opacity="@N(0.7 * t)" />
    }
}
